PORT=3001
OPENAI_API_KEY=your_openai_api_key_here
DEMO_TOKEN=your_demo_token_here
CLIENT_URL=http://localhost:5173
CONTACT_EMAIL=your_email@example.com
CONTACT_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
NODE_ENV=development

# Normal-mode quotas (shared across AI endpoints; reset at midnight UTC)
PUBLIC_DAILY_REQUESTS=20
PUBLIC_REQUESTS_PER_MINUTE=5
PUBLIC_GLOBAL_DAILY_REQUESTS=200
PUBLIC_DAILY_IMAGES=2
PUBLIC_GLOBAL_DAILY_IMAGES=20
# Must be on persistent disk; supports a single backend process.
USAGE_STATE_PATH=data/usage.json
# Optional: comma-separated trusted proxy IP addresses or subnets.
# Leave unset for direct connections. Never set this to trust all clients.
# TRUST_PROXY=loopback
